{
  // ---- Infraestructura como código (IaC) ----
  // Este archivo DECLARA toda la infra del proyecto. Cambiarlo = cambiar la nube.
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "serverless-rag-assistant",   // nombre del Worker en tu cuenta
  "main": "src/worker.js",              // el código que corre (handler HTTP + clase del Workflow)
  "compatibility_date": "2026-08-01",   // "congela" el comportamiento del runtime

  // Binding a Workers AI → dentro del código lo usas como env.AI
  "ai": { "binding": "AI" },

  // Binding a la base vectorial (Vectorize) → env.VECTORIZE
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "rag-index" }
  ],

  // Rate limiting nativo de Cloudflare (gratis, sin KV) para proteger /ask, /ingest e /ingest-url del abuso.
  // Dentro del código lo usas como env.RATE_LIMITER. 20 peticiones cada 60s por IP, contadas aparte
  // para preguntas ("ask:<ip>") e ingesta ("ingest:<ip>").
  //
  // Secreto requerido para ingestar (no va en este archivo): wrangler secret put INGEST_TOKEN
  // Sin ese secreto /ingest e /ingest-url responden 503 (la ingesta queda cerrada).
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  // Memoria de conversación de /ask en D1 (opcional) → env.DB. Guarda los últimos 5 turnos por
  // conversationId, sin IPs, con retención de 7 días (ver src/memory.js y migrations/).
  // Base creada con `npx wrangler d1 create rag-memory`; las migraciones nuevas se aplican con
  // `npx wrangler d1 migrations apply rag-memory --remote` antes de desplegar.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rag-memory",
      "database_id": "329c1268-a00f-47ba-bba2-c805a20a1c3b",
      "migrations_dir": "migrations"
    }
  ],

  // Ingesta durable de documentos grandes con Cloudflare Workflows → env.INGEST_WORKFLOW.
  // POST /ingest-jobs crea una instancia; cada lote de 50 fragmentos es un paso con reintentos.
  // Disponible en el plan gratis (10 ms de CPU por paso, 1 MiB de payload); se crea al desplegar.
  "workflows": [
    { "name": "rag-ingest", "binding": "INGEST_WORKFLOW", "class_name": "IngestWorkflow" }
  ]

  // Sin binding de R2 a propósito: hoy el Worker solo guarda el texto del fragmento en los
  // metadatos de Vectorize. El bucket `rag-source-docs` ya existe (terraform/), pero nada lo lee
  // ni lo escribe; el binding se agrega cuando el código guarde de verdad el documento original.
}
